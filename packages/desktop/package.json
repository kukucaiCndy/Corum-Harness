{
  "name": "corum-desktop",
  "description": "Corum（矩道）desktop carrier: Electron shell + host bridge + IPC transport, booting the corum profile over the official dsh foundation (zero HTTP).",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "author": "corum",
  "main": "lib/main.js",
  "bin": {
    "corum-desktop": "lib/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.ide.patch.yml": "./cordis.ide.patch.yml",
    "./cordis.dev-agent.patch.yml": "./cordis.dev-agent.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cordis.ide.patch.yml",
    "cordis.dev-agent.patch.yml"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run bundle",
    "build:lib": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json",
    "bundle": "tsdown --config tsdown.config.ts && node scripts/inline-monaco-css.mjs",
    "typecheck": "tsc -b tsconfig.host.json --pretty false && tsc -b tsconfig.client.json --pretty false",
    "start": "node lib/cli.js",
    "smoke": "node lib/cli.js --smoke",
    "pack:host": "node scripts/pack-macos.mjs",
    "pack:node": "node scripts/fetch-node.mjs",
    "pack:app": "electron-builder --mac --arm64",
    "pack": "npm run build && npm run pack:host && npm run pack:node && npm run pack:app"
  },
  "build": {
    "appId": "com.corum.agentos",
    "productName": "Corum",
    "asar": true,
    "files": [
      "lib/**/*",
      "cordis.patch.yml",
      "cordis.ide.patch.yml",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/host",
        "to": "host"
      },
      {
        "from": "build/node",
        "to": "node"
      },
      {
        "from": "build/dist",
        "to": "dist"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "extendInfo": {
      "CFBundleLocalizations": [
        "en",
        "zh-Hans"
      ],
      "CFBundleAllowMixedLocalizations": true,
      "CFBundleDisplayName": "矩道"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@corum/corum-agent-dev": "workspace:*",
    "@corum/corum-agent-ui-dev": "workspace:*",
    "@corum/corum-ide-conversation-ui": "workspace:*",
    "@corum/corum-ide-explorer-ui": "workspace:*",
    "@corum/corum-ide-panel-bottom-ui": "workspace:*",
