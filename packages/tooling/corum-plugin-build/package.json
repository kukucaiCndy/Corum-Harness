{
  "name": "@corum/plugin-build",
  "version": "0.7.0",
  "description": "corum 插件的构建契约唯一载体：宿主半 / 客户端半的 tsdown 配置工厂 + `corum-inline-css` bin。存在的理由是把「每个插件包各抄一份 banner/footer/externals/CSS 内联」收敛成一处 —— 那套闭包工厂契约（__ModuleLoader__ + CJS + externals 白名单 + CSS 内联）写在文档里没人能保证遵守，写在代码里第三方才能复用（插件规范 §7 / 方案 §A.1）。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "corum-inline-css": "./bin/corum-inline-css.mjs"
  },
  "files": [
    "lib",
    "bin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "peerDependencies": {
    "tsdown": "^0.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kukucaiCndy/Corum-Harness.git",
    "directory": "packages/tooling/corum-plugin-build"
  }
}
