{
  "name": "@corum/corum-theme",
  "version": "0.1.0",
  "description": "corum 液态玻璃主题：经 ctx.theme.overrideTokens 映射官方 --dsw-alias-* 到矩道 Corum Harness 设计 token（深/浅双值）+ 注入 --corum-* 玻璃变量/字体/光斑背景。",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && node scripts/inline-css.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
