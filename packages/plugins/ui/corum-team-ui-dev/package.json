{
  "name": "@corum/corum-team-ui-dev",
  "version": "0.1.0",
  "description": "corum 全局团队管理 UI：独立的团队（预设 Agent 集合）管理界面组件，可在 dev-agent combo 和未来 IDE 模式复用。【注意】本包是被 agent-ui-dev 内联的组件库（src/index.ts 的 apply 仅为占位），勿 insert 进 cordis patch（否则面板渲染两份、RPC 绑两次）",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && node scripts/inline-css.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@corum/corum-rpc-client": "workspace:^",
    "@corum/corum-ui-base": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-alpha.1",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@corum/corum-agent-dev": "workspace:*",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
