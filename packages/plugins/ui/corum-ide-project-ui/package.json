{
  "name": "@corum/corum-ide-project-ui",
  "version": "0.1.0",
  "description": "corum IDE 侧栏项目模式内容（付费版组合，design.pen L2 侧栏 ③/③b/④）：占 corum-ide-sidebar-ui 骨架声明的 corum.sidebar.project 子槽，提供打开项目分流（existing/wizard）、项目创建向导与项目详情（管理段/团队段）。数据源 corumProject/corumProjectData/corumAgent/corumTeam RPC（IDE combo 注入 @corum/corum-agent-dev 后可用）+ ctx.sessions（团队泳道会话）。",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && node scripts/inline-css.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@corum/corum-ide-ui": "workspace:*",
    "@corum/corum-rpc-client": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.1",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
