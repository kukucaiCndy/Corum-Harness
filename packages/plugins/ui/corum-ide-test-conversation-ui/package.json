{
  "name": "@corum/corum-ide-test-conversation-ui",
  "version": "0.6.0",
  "description": "S0 可行性测试插件：往壳的 conversation 槽注册占位（测试模块 + openDetails 按钮），验证中心列组合与 details 抽屉动作面。S2 曾由 @corum/corum-ide-conversation-ui 接管，该包已于 2026-09-11 删除（由 fork 的 corum-ui-conversation 取代）。",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@corum/corum-ide-ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  }
}
