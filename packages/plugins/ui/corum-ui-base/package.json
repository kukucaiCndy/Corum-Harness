{
  "name": "@corum/corum-ui-base",
  "version": "0.7.0",
  "description": "corum 通用壳基座：自由二维网格（grid 树模型 + 拖放/sash/持久化）+ 区域卡片基座（RegionCard）+ 集成中心磁贴墙（mosaic：错落排布算法 + 排布样式）+ 槽位注册机制 + 主题投影（ThemePresenter）+ 极简默认主题。不含任何 IDE 业务槽位与液态玻璃主题，子壳（如 ide-shell）在其上注册自己的槽位与布局。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/types/client/index.js"
    },
    "./sidebar.module.css": "./lib/types/client/sidebar.module.css",
    "./mosaic.module.css": "./lib/types/client/mosaic.module.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css && node scripts/copy-client-css.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.5-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.5-rc.3",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kukucaiCndy/Corum-Harness.git",
    "directory": "packages/plugins/ui/corum-ui-base"
  }
}
