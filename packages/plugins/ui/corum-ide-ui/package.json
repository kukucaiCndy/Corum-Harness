{
  "name": "@corum/corum-ide-ui",
  "version": "0.7.0",
  "description": "corum IDE 壳：区域系统（column/bar/drawer/overlay/floating）+ 槽位声明 + 几何求解（让位链/拖拽/窄屏收起）+ 液态玻璃主题（overrideTokens + 玻璃 CSS + ambient 光斑）+ ctx.layout 面板动作面。取代 @corum/corum-layout + @corum/corum-theme。",
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@corum/corum-rpc-client": "workspace:^",
    "@corum/corum-ui-base": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.5-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@corum/corum-ui-conversation": "workspace:*",
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.5-rc.3",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  }
}
