{
  "name": "@corum/ide-shell",
  "version": "0.1.0",
  "description": "corum IDE 壳：区域系统（column/bar/drawer/overlay/floating）+ 槽位声明 + 几何求解（让位链/拖拽/窄屏收起）+ 液态玻璃主题（overrideTokens + 玻璃 CSS + ambient 光斑）+ ctx.layout 面板动作面。取代 @corum/corum-layout + @corum/corum-theme。",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && node scripts/inline-css.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
