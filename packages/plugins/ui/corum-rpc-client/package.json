{
  "name": "@corum/corum-rpc-client",
  "version": "0.7.0",
  "description": "corum 自有 RPC 的浏览器调用助手：把已退役的 corumDesktop.unary IPC 桥手搓信封收敛为官方 connection.rpc.call('/api', '<ns>/<method>', { args })。供 corum 各 client UI 包（dev 面板 / IDE 面板）共享。",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/types/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kukucaiCndy/Corum-Harness.git",
    "directory": "packages/plugins/ui/corum-rpc-client"
  }
}
