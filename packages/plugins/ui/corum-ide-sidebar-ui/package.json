{
  "name": "@corum/corum-ide-sidebar-ui",
  "version": "0.7.0",
  "description": "corum IDE 左侧栏（任务/项目双模式）：任务模式提供真实会话列表，项目模式提供项目入口空态。注册进壳的 corum.sidebar 槽，任务数据源为 ctx.sessions/ctx.workspaces。",
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@corum/corum-ide-ui": "workspace:*",
    "@corum/corum-rpc-client": "workspace:^",
    "@corum/corum-ui-base": "workspace:*",
    "lucide-react": "^0.460.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@corum/corum-agent": "workspace:*",
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  }
}
