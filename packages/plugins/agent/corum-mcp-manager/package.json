{
  "name": "@corum/corum-mcp-manager",
  "version": "0.1.0",
  "description": "corum MCP 服务管理插件：全局注册表 + Agent 授权访问控制",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./proxy": {
      "types": "./lib/types/proxy.d.ts",
      "default": "./lib/proxy.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
