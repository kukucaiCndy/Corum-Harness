{
  "name": "@corum/corum-preset-modules",
  "version": "0.1.0",
  "description": "Agent 预设模块化（P0）：模块格式导出/导入 + MCP 前置依赖探测。纯函数库（不注册 cordis 服务），RPC 端点挂在 @corum/corum-agent 上。",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:shipped-modules": "node scripts/check-shipped-modules.mjs"
  },
  "dependencies": {
    "@corum/corum-mcp-manager": "workspace:*",
    "@corum/corum-skill-manager": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
