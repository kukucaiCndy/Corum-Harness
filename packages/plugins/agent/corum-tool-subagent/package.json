{
  "name": "@corum/corum-tool-subagent",
  "version": "0.1.0",
  "description": "corum 定制版子 Agent 召唤工具（fork 官方 dsh-tool-subagent 0.1.3-alpha.1）：execute 隔离层（写任务自动 git worktree+分支+deny str_replace_editor+会话级台账+maxParallelChildren）、integrate 编排骨架（集成者 persona+checks+settle 后清理，仅前台路径）、模型锁（config.model 终值注入+schema 剔除 LLM 选模型参数）、readonlyResearch 只读研究实例语义。与 @corum/corum-subagent（SubagentStartRequest.cwd）配套（docs/plan/PLAN-subagent-isolation.md）。",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./settings-registrar": {
      "types": "./lib/types/settings-registrar.d.ts",
      "default": "./lib/settings-registrar.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@corum/corum-orchestration": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-jobs": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
