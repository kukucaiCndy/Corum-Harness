{
  "name": "@corum/corum-subagent",
  "version": "0.7.0",
  "description": "corum 定制版子 Agent 委派 seam（fork 官方 dsh-subagent）：提供 ctx.subagents 能力接口（named-provider registry + startActivation/sendMessage API）。fork 增量：子 Agent 角色契约（worker / researcher 两类，性格相反，独立于父人格）+ childSessionMeta 透传 + corum 自有 spawn provider 命名。Service Definition 角色，provider 与 model-facing consumer 分属独立包。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./spawn": {
      "types": "./lib/types/spawn/index.d.ts",
      "default": "./lib/spawn/index.js"
    },
    "./fork": {
      "types": "./lib/types/fork/index.d.ts",
      "default": "./lib/fork/index.js"
    },
    "./isolated": {
      "types": "./lib/types/isolated/index.d.ts",
      "default": "./lib/isolated/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@corum/corum-orchestration": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-chunked-list": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection-cache": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-json": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-fork-in-process": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-subagent-control": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-time": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3"
  }
}
