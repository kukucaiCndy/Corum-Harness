{
  "name": "@corum/corum-extension-pack",
  "version": "0.7.0",
  "description": "扩展包（Extension Pack）格式定义、校验、扫描与安装（P1+P2）：纯函数库，定义扩展包清单格式、校验器、插件/UI 声明、包根分类，扫描包目录收集跨文件一致性问题，把扩展包整体落进用户根（skills→mcp→presets；plugins/themes/ui 登记成 deferred）。不注册 cordis 服务；pnpm add / entries.json / boot 折行属 P3/P4。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@corum/corum-extension-registry": "workspace:*",
    "@corum/corum-mcp-manager": "workspace:*",
    "@corum/corum-preset-modules": "workspace:*"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  }
}
