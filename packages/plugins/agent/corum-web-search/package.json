{
  "name": "@corum/corum-web-search",
  "version": "0.7.0",
  "description": "corum 联网搜索聚合 provider：把 ctx.web 的搜索能力收敛到一个 corum 自己的 provider（id `corum-web-search`，由桌面 overlay patch pin 住），默认子 provider 是 DeepSeek（直接实例化官方 DeepSeekSearchProvider、读同一个 web-search-deepseek settings 面 ⇒ 配了 DEEPSEEK_API_KEY 即可用，无需任何新配置），并允许其他插件经 cordis 服务 corumWebSearch 注册 / 启用各自的搜索供应商（settings namespace corum-web-search 的 activeProvider，切换即时生效、不需重启、也不会 WEB_PROVIDER_AMBIGUOUS）。",
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@corum/corum-api-remotes"
      ],
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@corum/corum-ui-base": "workspace:*"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-web-search-deepseek": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-web-search-deepseek": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
