{
  "name": "@corum/corum-extension-registry",
  "version": "0.7.0",
  "description": "扩展包归属台账（P5a）：纯 fs + node path 的中性小包，读写 <CORUM_HOME>/extension-packs/registry.json，回答「某资源由哪个扩展包拥有」。无 @corum 依赖（必须保持无环：skill/mcp manager、extension-pack、desktop、agent 都依赖它，反之不可）。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3"
  }
}
