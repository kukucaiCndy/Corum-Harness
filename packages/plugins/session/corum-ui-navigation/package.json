{
  "name": "@corum/corum-ui-navigation",
  "version": "0.7.0",
  "description": "corum 会话导航服务独立插件——提供 ctx.corumNavigation（会话选择与 retain/release 生命周期），替代禁用的官方 uiWorkspace 导航层。从 @corum/corum-ui-conversation 拆出（2026-10-31 循环依赖修复）：原 applyCorumSessionNavigation 在 conversation 的 apply() 内调用，而 conversation 硬 inject layout、ide-shell 硬 inject corumNavigation ⇒ layout↔corumNavigation 循环 ⇒ 23 插件 pending 阻塞 web boot。独立插件只 inject sessions，不依赖 layout/uiConversation，打破循环。",
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": [
        "@deepseek-ai/dsh-api-session-controller/client",
        "@deepseek-ai/dsh-client-store"
      ],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
