{
  "name": "@corum/corum-session-archive",
  "version": "0.7.0",
  "description": "corum 会话日志归档插件（保存会话日志 ZIP / 导入会话日志 ZIP，走桌面原生桥）",
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false"
  },
  "dependencies": {
    "@corum/corum-ide-ui": "workspace:*",
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "react": "^18.2.0"
  }
}
