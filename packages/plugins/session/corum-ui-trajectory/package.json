{
  "name": "@corum/corum-ui-trajectory",
  "version": "0.1.0",
  "description": "corum 定制版轨迹视图（fork 官方 @deepseek-ai/dsh-client-ui-trajectory）：保留官方轨迹时间线/表格组件与 ctx 注册，注册点从 conversation.view 迁到 corum 的 details 抽屉（右上角轨迹按钮）。",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@corum/corum-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown && node scripts/inline-css.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@corum/corum-ide-ui": "workspace:*",
    "@corum/corum-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
