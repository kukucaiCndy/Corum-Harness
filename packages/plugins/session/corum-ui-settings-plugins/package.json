{
  "name": "@corum/corum-ui-settings-plugins",
  "version": "0.7.0",
  "description": "corum 定制版 Plugins settings surface（fork 官方 dsh-client-ui-settings-plugins 0.1.3-alpha.1）：与官方逐行一致，实质 diff = ① SubagentModelSelectionCard 不再注册进 settings.plugin.item（该槽无渲染者），改由本包注册的 settings.section「子 Agent 候选模型」承载（全局候选集入口；单预设覆盖在 Agent 预设编辑页，两层是「默认 + 覆盖」的设计）；② 移除 web-search 卡注册（已搬到 @corum/corum-web-search 的 section）。controller 实例保留（host namespace subagent-model-selection 仍可读写，避免存量设置文档出现未注册段）。",
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@corum/corum-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown && corum-inline-css",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "devDependencies": {
    "@corum/plugin-build": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "lib"
  ],
  "corum": {
    "plugin": {
      "api": 1,
      "host": ">=0.6.0 <0.7.0",
      "kind": "builtin"
    }
  }
}
