{
  "name": "corum-harness",
  "version": "0.7.0",
  "description": "corum Agent OS — a plugin-cluster distribution over the DeepSeek Harness foundation: my own Agent system (context, UI, agent, workflow) plus an Electron desktop carrier.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:all": "node scripts/build-all.mjs",
    "build:verify": "node scripts/build-all.mjs --verify",
    "verify:plugin-spec": "node scripts/verify-plugin-spec.mjs",
    "verify:plugin-spec:strict": "node scripts/verify-plugin-spec.mjs --strict",
    "verify:plugin-ui": "node scripts/verify-plugin-ui-surface.mjs",
    "verify:plugin-guide": "node scripts/verify-plugin-guide.mjs",
    "create:plugin": "node scripts/create-plugin.mjs",
    "verify:publish-shape": "node scripts/verify-plugin-publish-shape.mjs",
    "verify:plugin-install": "node scripts/verify-plugin-install-e2e.mjs",
    "typecheck": "pnpm -r run typecheck",
    "shell:dev": "pnpm --filter corum-desktop run start",
    "shell:smoke": "pnpm --filter corum-desktop run smoke",
    "smoke": "node scripts/corum-smoke.mjs --fast",
    "smoke:launch": "node scripts/corum-smoke.mjs --fast --launch",
    "smoke:full": "node scripts/corum-smoke.mjs --full --launch",
    "smoke:packaged": "node scripts/corum-smoke.mjs --fast --launch --packaged",
    "assert:boot": "node scripts/assert-packaged-boot.mjs",
    "verify:electron-pin": "node scripts/verify-electron-pin.mjs",
    "pack": "pnpm --filter corum-desktop run pack",
    "pack:linux": "pnpm --filter corum-desktop run pack:linux",
    "pack:win": "pnpm --filter corum-desktop run pack:win",
    "release": "node scripts/release.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "anser": "^2.3.5",
    "katex": "^0.16.47",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1"
  }
}
