{
  "name": "corum-harness",
  "version": "0.1.0",
  "description": "corum Agent OS — a plugin-cluster distribution over the DeepSeek Harness foundation: my own Agent system (context, UI, agent, workflow) plus an Electron desktop carrier.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "shell:dev": "pnpm --filter corum-shell run start",
    "shell:smoke": "pnpm --filter corum-shell run smoke",
    "pack": "pnpm --filter corum-shell run pack"
  }
}
